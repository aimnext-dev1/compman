# dtx-docker-manager 스택 설정 파일
#
# 사용법: 이 파일을 stack.env로 복사한 후(또는 `make init`) 값을 채우세요.
#   cp stack.env.example stack.env
#
# stack.env는 프로젝트 루트에 위치해야 하며, _script/*.sh가 공통으로 읽어옵니다.
# _script/ 내부 개별 파일을 더 이상 직접 수정할 필요가 없습니다.

# _project 폴더 존재 확인 메시지에 표시할 이름 (임의의 식별용 이름)
FOLDER_NAME=

# docker compose 프로젝트명(-p 옵션)으로 사용됩니다. 백업 파일명 접두사로도 쓰입니다.
STACK_NAME=

# 실행환경별 docker compose 명세 파일명 (_project/compose 폴더 기준)
# COMPOSE_BASE_FILE을 설정하지 않으면 각 파일이 독립된 전체 스펙이어야 합니다.
COMPOSE_FILE_LOCAL=
COMPOSE_FILE_DEV=
COMPOSE_FILE_PROD=

# (선택) 공통 베이스 compose 파일명. 설정하면 모든 환경에서
# `-f COMPOSE_BASE_FILE -f COMPOSE_FILE_<ENV>` 로 조합되어 실행됩니다.
# 서비스 정의는 베이스에 두고, 환경별 파일에는 차이나는 부분만 작성하세요.
#COMPOSE_BASE_FILE=docker-compose.yml

# 실행환경별 환경변수 파일 경로 (선택, 필요한 환경만 채우면 됩니다)
#ENV_FILE_LOCAL=
#ENV_FILE_DEV=
#ENV_FILE_PROD=
